{
  "name": "tycho",
  "version": "3.0.0",
  "private": true,
  "homepage": "https://tycho.io",
  "description": "A real-time, WebGL-based interactive simulation of the solar system.",
  "type": "module",
  "author": {
    "name": "Josh Shor",
    "email": "jpshor@gmail.com",
    "url": "https://josh.so/"
  },
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build && yarn ephemerides:build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-webstorage vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ephemerides": "tsx ./src/ephemerides/index.ts --ephemerides",
    "ephemerides:build": "tsx ./src/ephemerides/index.ts --build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tweenjs/tween.js": "^25.0.0",
    "glob": "^13.0.6",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.0",
    "react-slider": "^2.0.6",
    "three": "^0.185.1",
    "ts-node": "^10.9.2",
    "webgl-detect": "^0.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-slider": "^1.3.6",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "classnames": "^2.5.1",
    "codecov": "^3.8.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
