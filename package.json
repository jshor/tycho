{
    "name": "tycho",
    "version": "1.0.1",
    "private": true,
    "homepage": "https://www.tycho.io",
    "description": "A real-time, WebGL-based interactive simulation of our solar system.",
    "author": {
        "name": "Josh Shor",
        "email": "jpshor@gmail.com",
        "url": "https://www.josh.so/"
    },
    "bugs": {
        "url": "https://github.com/jshor/tycho/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jshor/tycho.git"
    },
    "license": "MIT",
    "scripts": {
        "start": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "deploy:upload": "s3-deploy './dist/**' --cwd './dist/' --bucket www.tycho.io",
        "deploy:invalidate": "cf-invalidate -- E1MEFM58XJK3X1 *",
        "deploy": "npm-run-all deploy:upload deploy:invalidate",
        "lint": "eslint src/**/*.ts src/**/*.tsx",
        "lint:fix": "eslint --fix src/**/*.ts src/**/*.tsx",
        "ephemeris": "tycho-scripts -m ephemeris",
        "orbitals": "tycho-scripts -m orbitals"
    },
    "dependencies": {
        "@react-three/drei": "^9.109.0",
        "@react-three/fiber": "^8.17.0",
        "classnames": "2.2.5",
        "js-cookie": "2.2.0",
        "keymirror": "0.1.1",
        "moment": "^2.19.3",
        "react": "^18.2.0",
        "react-datetime": "^3.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^9.0.0",
        "react-redux": "^9.1.0",
        "react-slider": "^2.0.6",
        "redux": "^4.2.1",
        "redux-thunk": "^2.4.2",
        "three": "^0.165.0",
        "tween.js": "16.6.0",
        "webgl-detect": "^0.0.1"
    },
    "devDependencies": {
        "@types/classnames": "^2.2.6",
        "@types/enzyme": "^3.1.0",
        "@types/jest": "^27.0.0",
        "@types/js-cookie": "^2.2.0",
        "@types/node": "^18.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/react-redux": "^7.1.33",
        "@types/three": "^0.165.0",
        "babel-eslint": "^8.0.2",
        "cloudfront-invalidate-cli": "^1.4.0",
        "enzyme": "3.11.0",
        "enzyme-to-json": "3.6.2",
        "eslint": "^4.1.1",
        "eslint-config-react-app": "^2.0.1",
        "eslint-plugin-flowtype": "^2.34.1",
        "eslint-plugin-import": "^2.6.0",
        "eslint-plugin-jsx-a11y": "^6.0.2",
        "eslint-plugin-react": "^7.1.0",
        "@vitejs/plugin-react": "^4.3.0",
        "husky": "^0.14.3",
        "npm-run-all": "4.1.2",
        "sass": "^1.77.0",
        "vite": "^5.3.0",
        "react-test-renderer": "^18.2.0",
        "rimraf": "2.6.2",
        "tycho-scripts": "^1.0.3",
        "typescript": "^5.4.0",
        "web-audio-mock": "^0.1.9"
    },
    "husky": {
        "hooks": {
            "pre-push": "npm run prepush"
        }
    }
}
