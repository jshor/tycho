{
  "name": "tycho",
  "version": "1.0.1",
  "private": true,
  "homepage": "https://www.tycho.io",
  "description": "A real-time, WebGL-based interactive simulation of our solar system.",
  "type": "module",
  "author": {
    "name": "Josh Shor",
    "email": "jpshor@gmail.com",
    "url": "https://www.josh.so/"
  },
  "bugs": {
    "url": "https://github.com/jshor/tycho/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jshor/tycho.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-webstorage vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ephemeris": "tycho-scripts -m ephemeris",
    "orbitals": "tycho-scripts -m orbitals"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "moment": "^2.19.3",
    "react": "^19.2.8",
    "react-datetime": "^3.2.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.0",
    "react-slider": "^2.0.6",
    "three": "^0.165.0",
    "tween.js": "16.6.0",
    "webgl-detect": "^0.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^18.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-slider": "^1.3.6",
    "@types/three": "^0.165.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "classnames": "^2.5.1",
    "codecov": "^3.8.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.6.0",
    "eslint-plugin-jsx-a11y": "^6.0.2",
    "eslint-plugin-react": "^7.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.77.0",
    "tycho-scripts": "^1.0.3",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "web-audio-mock": "^0.1.9"
  }
}
